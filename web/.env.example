# Image generation API (OpenAI-compatible proxy). Server-side only; never exposed to the browser.
BLTCY_API_KEY=sk-your-key-here
BLTCY_BASE_URL=https://api.bltcy.ai
# Model name passed to the upstream API (e.g. gpt-image-1, gpt-image-2).
IMAGE_MODEL=gpt-image-1

# Admin password for the /admin invite-code management page.
ADMIN_PASSWORD=change-me
# Directory where the SQLite database file (app.db) is stored. Defaults to ./data.
DATA_DIR=./data
